# Environment Configuration Example
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Database name
DB_NAME=habifarm_db

# Database user
DB_USER=habifarm_user

# Database password (use a strong password in production!)
DB_PASSWORD=your_secure_password_here

# Database host (typically localhost for local development)
DB_HOST=localhost

# Database port (default MySQL port is 3306)
DB_PORT=3306

# Database table prefix
DB_TABLE_PREFIX=wp_

# Database character set
DB_CHARSET=utf8mb4

# Database collation
DB_COLLATE=utf8mb4_unicode_520_ci

# =============================================================================
# WORDPRESS CONFIGURATION
# =============================================================================

# WordPress environment (development, staging, production)
WP_ENV=development

# WordPress debug mode (true for development, false for production)
WP_DEBUG=true

# WordPress debug log (logs errors to wp-content/debug.log)
WP_DEBUG_LOG=true

# WordPress debug display (false to hide errors on screen, even if WP_DEBUG is true)
WP_DEBUG_DISPLAY=false

# Script debug (loads unminified core JavaScript and CSS files)
SCRIPT_DEBUG=true

# Disable file editing from WordPress admin
WP_DISABLE_FILE_EDIT=false

# WordPress site URL (include http:// or https://)
WP_SITE_URL=http://localhost

# WordPress home URL
WP_HOME=http://localhost

# =============================================================================
# SECURITY KEYS AND SALTS
# =============================================================================
# Generate unique keys at: https://api.wordpress.org/secret-key/1.1/salt/
# These should be different from the defaults and should be kept secret!

AUTH_KEY='put your unique phrase here'
SECURE_AUTH_KEY='put your unique phrase here'
LOGGED_IN_KEY='put your unique phrase here'
NONCE_KEY='put your unique phrase here'
AUTH_SALT='put your unique phrase here'
SECURE_AUTH_SALT='put your unique phrase here'
LOGGED_IN_SALT='put your unique phrase here'
NONCE_SALT='put your unique phrase here'

# =============================================================================
# WEB SERVER CONFIGURATION
# =============================================================================

# Server port (80 for HTTP, 443 for HTTPS)
SERVER_PORT=80

# Server name/domain
SERVER_NAME=habifarm.local

# Document root
DOCUMENT_ROOT=/var/www/habifarm

# PHP-FPM socket path
PHP_FPM_SOCKET=/var/run/php/php-fpm.sock

# =============================================================================
# WOOCOMMERCE CONFIGURATION
# =============================================================================

# WooCommerce currency
WOOCOMMERCE_CURRENCY=USD

# WooCommerce tax rate (as decimal, e.g., 0.025 for 2.5%)
WOOCOMMERCE_TAX_RATE=0.025

# Enable WooCommerce debug mode
WOOCOMMERCE_DEBUG=false

# =============================================================================
# MULTIVENDORX CONFIGURATION
# =============================================================================

# Default commission rate (as decimal, e.g., 0.15 for 15%)
MVX_COMMISSION_RATE=0.15

# Commission type (percentage, fixed, or percent_product)
MVX_COMMISSION_TYPE=percentage

# Auto-approve vendors (true/false)
MVX_AUTO_APPROVE_VENDORS=false

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================

# SMTP settings (for production email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# From email address
SMTP_FROM_EMAIL=noreply@habifarm.com
SMTP_FROM_NAME=Habifarm

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Maximum upload file size (in MB)
UPLOAD_MAX_FILESIZE=64

# Maximum POST size (in MB)
POST_MAX_SIZE=128

# Maximum number of files in upload
MAX_FILE_UPLOADS=20

# =============================================================================
# PERFORMANCE & CACHING
# =============================================================================

# Enable object caching (requires Redis or Memcached)
ENABLE_CACHE=false

# Redis configuration (if using Redis for caching)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache expiration time (in seconds)
CACHE_EXPIRATION=3600

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log level (debug, info, warning, error)
LOG_LEVEL=debug

# Error log path
ERROR_LOG_PATH=/var/log/habifarm/error.log

# Access log path
ACCESS_LOG_PATH=/var/log/habifarm/access.log

# Enable query logging (for debugging slow queries)
ENABLE_QUERY_LOG=false

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup directory
BACKUP_DIR=/var/backups/habifarm

# Number of backups to retain
BACKUP_RETENTION=7

# Backup schedule (cron format: minute hour day month weekday)
BACKUP_SCHEDULE='0 2 * * *'

# =============================================================================
# PAYMENT GATEWAY CONFIGURATION
# =============================================================================
# Note: These are placeholders. Add your actual payment gateway credentials.

# Stripe (if using)
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal (if using)
PAYPAL_CLIENT_ID=your_client_id_here
PAYPAL_SECRET=your_secret_here
PAYPAL_MODE=sandbox # sandbox or live

# =============================================================================
# API CONFIGURATION
# =============================================================================

# API base URL
API_BASE_URL=http://localhost/wp-json

# API authentication
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Rate limiting
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=3600

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================

# Google Maps API (if using location features)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Twilio (if using SMS notifications)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# AWS S3 (if using for file storage)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=habifarm-uploads

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================

# Enable query monitor (WordPress plugin)
ENABLE_QUERY_MONITOR=true

# Enable Xdebug
ENABLE_XDEBUG=false

# Xdebug settings
XDEBUG_MODE=debug
XDEBUG_START_WITH_REQUEST=yes
XDEBUG_CLIENT_PORT=9003

# =============================================================================
# CUSTOM APPLICATION SETTINGS
# =============================================================================

# Rental delivery time (in days)
RENTAL_DELIVERY_DAYS=5

# Minimum rental period (in days)
MINIMUM_RENTAL_DAYS=1

# Maximum rental period (in days)
MAXIMUM_RENTAL_DAYS=365

# Equipment approval required
EQUIPMENT_APPROVAL_REQUIRED=true

# Customer support email
SUPPORT_EMAIL=support@habifarm.com

# Terms of service URL
TERMS_URL=http://habifarm.com/terms

# Privacy policy URL
PRIVACY_URL=http://habifarm.com/privacy
